{
  "name": "morrowkit-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "The MorrowKit template and create-morrowkit CLI workspace.",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter morrowkit dev",
    "setup": "pnpm --filter morrowkit setup",
    "build": "pnpm -r build",
    "start": "pnpm --filter morrowkit start",
    "cli": "pnpm --filter create-morrowkit dev",
    "supabase:start": "pnpm --filter morrowkit supabase:start",
    "supabase:stop": "pnpm --filter morrowkit supabase:stop",
    "supabase:reset": "pnpm --filter morrowkit supabase:reset",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter morrowkit test:e2e",
    "test:e2e:ui": "pnpm --filter morrowkit test:e2e:ui",
    "test:watch": "pnpm --filter morrowkit test:watch",
    "test:db": "pnpm --filter morrowkit test:db",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=10.0.0"
  }
}
