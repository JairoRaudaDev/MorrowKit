{
  "name": "create-morrowkit",
  "version": "0.1.0",
  "description": "Create a new MorrowKit application.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JairoRaudaDev/MorrowKit.git",
    "directory": "packages/create-morrowkit"
  },
  "bugs": {
    "url": "https://github.com/JairoRaudaDev/MorrowKit/issues"
  },
  "homepage": "https://github.com/JairoRaudaDev/MorrowKit#readme",
  "keywords": [
    "morrowkit",
    "create-app",
    "nextjs",
    "saas",
    "starter",
    "supabase",
    "stripe",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "create-morrowkit": "dist/index.mjs"
  },
  "files": [
    "dist",
    "template"
  ],
  "scripts": {
    "dev": "node src/index.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run lint",
    "test": "node --test test/*.test.mjs",
    "lint": "node --check src/index.mjs && node --check scripts/build.mjs",
    "typecheck": "node --check src/index.mjs && node --check scripts/build.mjs",
    "format": "prettier --write src scripts test package.json README.md",
    "format:check": "prettier --check src scripts test package.json README.md"
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
